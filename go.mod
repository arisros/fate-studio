// an HTTP chart viewer and live simulator. It is a separate module from the
// engine (github.com/arisros/fate) so the engine stays dependency-free.
module github.com/arisros/fate-studio

go 1.24

require github.com/arisros/fate v0.13.1-0.20261011035719-c13d7b2c9838
